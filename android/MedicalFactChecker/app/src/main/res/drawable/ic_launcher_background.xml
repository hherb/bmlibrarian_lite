<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher_background.xml
    MedicalFactChecker Android App

    Vector drawable for adaptive icon background.
    Blue gradient matching the iOS app icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gradient background from dark blue (top-left) to lighter blue (bottom-right) -->
    <group>
        <path
            android:fillColor="#1E3A5F"
            android:pathData="M0,0h108v108h-108z"/>
        <!-- Lighter overlay for gradient effect -->
        <path
            android:fillColor="#2E5A8F"
            android:fillAlpha="0.6"
            android:pathData="M54,0L108,0L108,108L0,108z"/>
    </group>

</vector>
