<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher_foreground.xml
    MedicalFactChecker Android App

    Vector drawable for adaptive icon foreground.
    Matches iOS app icon: white medical cross with green checkmark badge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White medical cross (plus sign) - centered slightly left -->
    <!-- Vertical bar of cross -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,28L52,28L52,46L42,46Z"/>
    <!-- Horizontal bar of cross -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,38L62,38L62,48L32,48Z"/>
    <!-- Extended vertical bar (bottom) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,46L52,46L52,72L42,72Z"/>

    <!-- Subtle shadow/depth effect on cross -->
    <path
        android:fillColor="#D0D0D0"
        android:fillAlpha="0.3"
        android:pathData="M47,28L52,28L52,72L47,72Z"/>

    <!-- Green circle badge (bottom-right) -->
    <path
        android:fillColor="#4CAF50"
        android:pathData="M68,68m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0"/>

    <!-- Darker green border on circle -->
    <path
        android:fillColor="#388E3C"
        android:pathData="M68,68m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0"
        android:strokeColor="#388E3C"
        android:strokeWidth="1"/>

    <!-- White checkmark inside green circle -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M60,68L66,74L77,62"/>

</vector>
