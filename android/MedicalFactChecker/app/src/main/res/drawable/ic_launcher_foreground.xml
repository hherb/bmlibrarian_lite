<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher_foreground.xml
    MedicalFactChecker Android App

    Vector drawable for adaptive icon foreground.
    Matches iOS app icon: white medical cross with green checkmark badge.

    iOS icon (1024x1024):
    - Cross: equal arms, 200px thick, 500px long
    - Vertical bar: x=412-612, y=180-680
    - Horizontal bar: x=262-762, y=330-530
    - Checkmark circle: center (700, 700), radius 180

    Android adaptive icon safe zone: center 66dp of 108dp (21-87)
    Cross centered at (49, 49), each bar 38dp long x 14dp thick.
    Equal arm length = (38-14)/2 = 12dp per arm from center.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle document/paper element behind cross (matches iOS opacity 0.15) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.12"
        android:pathData="M38,52 L56,52 L56,88 L38,88 Z"/>

    <!-- White medical cross - vertical bar with rounded corners -->
    <!-- 14dp wide (x: 42-56), 38dp tall (y: 28-66), centered at (49, 47) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,28 L54,28 Q56,28 56,30 L56,64 Q56,66 54,66 L44,66 Q42,66 42,64 L42,30 Q42,28 44,28 Z"/>

    <!-- White medical cross - horizontal bar with rounded corners -->
    <!-- 38dp wide (x: 30-68), 14dp tall (y: 40-54), centered at (49, 47) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,40 L66,40 Q68,40 68,42 L68,52 Q68,54 66,54 L32,54 Q30,54 30,52 L30,42 Q30,40 32,40 Z"/>

    <!-- Subtle gradient overlay on cross (right side) for depth -->
    <path
        android:fillColor="#E8F0FF"
        android:fillAlpha="0.4"
        android:pathData="M49,28 L54,28 Q56,28 56,30 L56,64 Q56,66 54,66 L49,66 Z"/>

    <!-- Green circle badge (bottom-right) -->
    <path
        android:fillColor="#4CAF50"
        android:pathData="M66,66 m-12,0 a12,12 0,1 1,24 0 a12,12 0,1 1,-24 0"/>

    <!-- Darker green inner shadow for depth -->
    <path
        android:fillColor="#2E7D32"
        android:fillAlpha="0.3"
        android:pathData="M66,66 m-12,0 a12,12 0,0 1,24 0"/>

    <!-- White checkmark inside green circle -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M59,66 L64,71 L74,60"/>

</vector>
